{
  "name": "knowledge-video-remotion-template",
  "version": "0.1.0",
  "private": true,
  "description": "Content-led Remotion knowledge videos with reusable scenes and independent audio",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "new": "node scripts/cli.mjs new",
    "doctor": "node scripts/cli.mjs doctor",
    "check": "node scripts/cli.mjs check",
    "prepare": "node scripts/cli.mjs prepare",
    "audio": "node scripts/cli.mjs audio",
    "preview": "node scripts/cli.mjs preview",
    "review": "node scripts/cli.mjs review",
    "stills": "node scripts/cli.mjs stills",
    "render": "node scripts/cli.mjs render",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "demo:assets": "node scripts/demo-assets.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "release": "node scripts/release.mjs",
    "verify:integration": "node scripts/verify-integration.mjs",
    "verify:studio": "node scripts/verify-studio.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.1",
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/player": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "ffmpeg-static": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
