{
  "items": [
    {
      "id": "deal-0",
      "segmentId": "deal",
      "start": 0,
      "end": 1.8,
      "text": "主播先报：这件原价999元。"
    },
    {
      "id": "deal-1",
      "segmentId": "deal",
      "start": 1.8,
      "end": 3.6,
      "text": "从999降到599。"
    },
    {
      "id": "deal-2",
      "segmentId": "deal",
      "start": 3.6,
      "end": 7,
      "text": "再降到199，觉得少花了800。"
    },
    {
      "id": "deal-3",
      "segmentId": "deal",
      "start": 7,
      "end": 10,
      "text": "你心动了，正准备下单。"
    },
    {
      "id": "deal-4",
      "segmentId": "deal",
      "start": 10,
      "end": 14,
      "text": "先等等：遮住原价，查同款的实际到手价。"
    },
    {
      "id": "trap-0",
      "segmentId": "trap",
      "start": 0,
      "end": 3.2,
      "text": "遮住屏幕上的999，心里却可能仍拿它当参照。"
    },
    {
      "id": "trap-1",
      "segmentId": "trap",
      "start": 3.2,
      "end": 6.2,
      "text": "只算少了800，还没核查这件衣服本身值多少。"
    },
    {
      "id": "trap-2",
      "segmentId": "trap",
      "start": 6.2,
      "end": 10,
      "text": "这就是锚定的影响：最初的数字可能成为判断的参照。"
    },
    {
      "id": "rewind-0",
      "segmentId": "rewind",
      "start": 0,
      "end": 3.25,
      "text": "先找反证，核对同款同条件的可比价格。"
    },
    {
      "id": "rewind-1",
      "segmentId": "rewind",
      "start": 3.25,
      "end": 5.3,
      "text": "例：199比189高10元。"
    },
    {
      "id": "rewind-2",
      "segmentId": "rewind",
      "start": 5.3,
      "end": 8,
      "text": "有需要、预算合适，再决定买不买。"
    },
    {
      "id": "evidence-0",
      "segmentId": "evidence",
      "start": 0,
      "end": 1.8,
      "text": "换到二手砍价，也先找依据。"
    },
    {
      "id": "evidence-1",
      "segmentId": "evidence",
      "start": 1.8,
      "end": 5.6,
      "text": "先检查：有磨损，配件也不齐。"
    },
    {
      "id": "evidence-2",
      "segmentId": "evidence",
      "start": 5.6,
      "end": 8.8,
      "text": "再查同款、成色相近的实际成交。"
    },
    {
      "id": "evidence-3",
      "segmentId": "evidence",
      "start": 8.8,
      "end": 11.4,
      "text": "例：可比成交1100–1300元。"
    },
    {
      "id": "evidence-4",
      "segmentId": "evidence",
      "start": 11.4,
      "end": 14,
      "text": "结合成色、配件谈价，减少报价牵引。"
    },
    {
      "id": "reprice-0",
      "segmentId": "reprice",
      "start": 0,
      "end": 3.1,
      "text": "参考成交区间，还要结合这台的成色与配件。"
    },
    {
      "id": "reprice-1",
      "segmentId": "reprice",
      "start": 3.1,
      "end": 6,
      "text": "例：说明商品状况后，提出1200元报价。"
    },
    {
      "id": "reprice-2",
      "segmentId": "reprice",
      "start": 6,
      "end": 8.5,
      "text": "卖家不接受，也不必急着加价。"
    },
    {
      "id": "reprice-3",
      "segmentId": "reprice",
      "start": 8.5,
      "end": 12,
      "text": "可以换一家，或暂时不买。"
    },
    {
      "id": "close-0",
      "segmentId": "close",
      "start": 0,
      "end": 3.7,
      "text": "问报价依据，主动找反证。"
    },
    {
      "id": "close-1",
      "segmentId": "close",
      "start": 3.7,
      "end": 7,
      "text": "比较可比信息，再按需要和预算决定。"
    },
    {
      "id": "close-2",
      "segmentId": "close",
      "start": 7,
      "end": 12,
      "text": "便宜多少，要看它和谁比；买不买，要看自己的依据。"
    }
  ]
}
