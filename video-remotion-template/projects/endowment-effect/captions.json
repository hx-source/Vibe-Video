{
  "items": [
    {
      "id": "question-0",
      "segmentId": "question",
      "start": 0,
      "end": 4.6,
      "text": "买杯子时，30 元你嫌贵。"
    },
    {
      "id": "question-1",
      "segmentId": "question",
      "start": 5,
      "end": 9.6,
      "text": "可它刚变成你的，60 元你也舍不得卖。"
    },
    {
      "id": "question-2",
      "segmentId": "question",
      "start": 10,
      "end": 15.8,
      "text": "杯子没变，为什么心理价变了？"
    },
    {
      "id": "experiment-0",
      "segmentId": "experiment",
      "start": 0,
      "end": 4.6,
      "text": "研究者把学生随机分组，其中一组得到杯子。"
    },
    {
      "id": "experiment-1",
      "segmentId": "experiment",
      "start": 5,
      "end": 9.6,
      "text": "买者与卖者，对同类杯子给出了不同估值。"
    },
    {
      "id": "experiment-2",
      "segmentId": "experiment",
      "start": 10,
      "end": 17.7,
      "text": "还有一组，只需要在杯子和现金之间选择。"
    },
    {
      "id": "name-0",
      "segmentId": "name",
      "start": 0,
      "end": 4.6,
      "text": "仅仅拥有，就可能让你更不愿意放手。"
    },
    {
      "id": "name-1",
      "segmentId": "name",
      "start": 5,
      "end": 9.6,
      "text": "这种现象，被称为禀赋效应。"
    },
    {
      "id": "name-2",
      "segmentId": "name",
      "start": 10,
      "end": 15.7,
      "text": "它可以很快出现，不必等到物品积累了回忆。"
    },
    {
      "id": "boundary-0",
      "segmentId": "boundary",
      "start": 0,
      "end": 4.6,
      "text": "但好用、有回忆，也确实是价值。"
    },
    {
      "id": "boundary-1",
      "segmentId": "boundary",
      "start": 5,
      "end": 11.7,
      "text": "不能把每次舍不得卖，都归结为禀赋效应。"
    },
    {
      "id": "reset-0",
      "segmentId": "reset",
      "start": 0,
      "end": 4.6,
      "text": "试着问：如果还没拥有，我愿意花多少买它？"
    },
    {
      "id": "reset-1",
      "segmentId": "reset",
      "start": 5,
      "end": 8.7,
      "text": "再把功能、回忆和交易成本分开想。"
    },
    {
      "id": "reset-2",
      "segmentId": "reset",
      "start": 9,
      "end": 13.7,
      "text": "从今天的需要出发，重新决定去留。"
    },
    {
      "id": "mechanism-0",
      "segmentId": "mechanism",
      "start": 0,
      "end": 3.8,
      "text": "同一个人，30元买这只杯子，他嫌贵。"
    },
    {
      "id": "mechanism-1",
      "segmentId": "mechanism",
      "start": 4,
      "end": 5.9,
      "text": "现在，这只杯子免费送给他。"
    },
    {
      "id": "mechanism-2",
      "segmentId": "mechanism",
      "start": 6,
      "end": 8.2,
      "text": "有人出30元收购，他却不愿卖。"
    },
    {
      "id": "mechanism-3",
      "segmentId": "mechanism",
      "start": 8.3,
      "end": 17.7,
      "text": "成为“我的”之后，放弃就更难。"
    }
  ]
}
